# Local secrets and environment files
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
credentials.json
**/application-local.*
**/application-secret.*

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Editor files
.idea/
*.iml
.vscode/
*.swp
*~

# Java, Maven, and Gradle build output
target/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*
.gradle/
build/
out/
