!.mvn/wrapper/maven-wrapper.jar

# Node, Next.js, and Expo output
node_modules/
.next/
dist/
.expo/
.expo-shared/
web-build/
coverage/
*.tsbuildinfo
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# React Native native build output
apps/mobile/android/.gradle/
apps/mobile/android/app/build/
apps/mobile/android/build/
apps/mobile/ios/Pods/
apps/mobile/ios/build/
*.mobileprovision

# Test and analysis output
jacoco.exec
.scannerwork/
.sonar/
